# .env.example - Plantilla de variables de entorno. Copia a .env y ajusta; nunca versiones el .env real.
# Los scripts NO cargan este archivo solos: haz `set -a; source .env; set +a` antes de ejecutarlos.

# --- Base de datos (leídas por scripts/respaldo.sh; el script falla si falta alguna) ---

# Servidor de PostgreSQL al que pg_dump se conecta para el respaldo.
DB_HOST=db-ejemplo.edf-ficticio.invalid

# Usuario de PostgreSQL con permiso de lectura para pg_dump.
DB_USER=usuario_ejemplo

# Contraseña de ese usuario (credencial). Se pasa a pg_dump como PGPASSWORD.
DB_PASSWORD=CAMBIAR_EN_EL_SERVIDOR

# --- Notificaciones (opcionales: hoy scripts/notifica.sh las tiene escritas dentro del script) ---

# URL del webhook al que notifica.sh envía el POST.
# WEBHOOK_URL=https://alertas.edf-ficticio.invalid/api/v1/notificar

# Token Bearer del webhook (credencial).
# WEBHOOK_TOKEN=CAMBIAR_EN_EL_SERVIDOR
