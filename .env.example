# .env.example - Plantilla de variables de entorno del proyecto.
# Copia este archivo a .env y llena los valores reales en el servidor.
# Nunca subas a Git el .env con valores reales.

# Servidor de PostgreSQL al que se conecta scripts/respaldo.sh para hacer pg_dump.
DB_HOST=db-ejemplo-01.ejemplo.invalid

# Usuario de la base de datos que usa pg_dump en scripts/respaldo.sh.
DB_USER=CAMBIAR_EN_EL_SERVIDOR

# Contraseña del usuario de la base (se pasa a pg_dump como PGPASSWORD).
DB_PASSWORD=CAMBIAR_EN_EL_SERVIDOR
