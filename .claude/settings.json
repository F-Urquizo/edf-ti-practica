{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(bash scripts/revisa-secretos.sh*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(docker *)",
      "Bash(systemctl *)",
      "Bash(ssh *)",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.produccion)",
      "Read(**/.env.production)",
      "Read(**/llaves/**)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.ppk)",
      "Read(**/*.pfx)",
      "Read(**/*.p12)",
      "Read(~/.ssh/**)",
      "Read(./config/app.conf)",
      "Read(./logs/accesos*.log)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(cat config/.env*)",
      "Bash(cat llaves/*)",
      "Bash(git log -p*)",
      "Bash(git log --patch*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)"
    ]
  }
}
